  "dependencies": { "zod": "^4.1.0" },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check index.js && node --check core.js && node --check contracts.js && node --check client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"] }
