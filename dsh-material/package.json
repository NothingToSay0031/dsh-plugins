{
  "name": "@local/dsh-material",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Gradient, translucency and blur material layer for the DSH client, stacked over the built-in palettes through ctx.theme.overrideTokens, with light palettes and opacity, blur and saturation controls in the sidebar More menu.",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "locale", "README.md", "tools/check-materials.mjs"],
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "validate": "node tools/check-materials.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
