{
  "name": "@local/dsh-compaction-targets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edit per-model compaction points in the DSH desktop profile.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "compaction-patch.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/js-yaml.cjs",
    "vendor/js-yaml.LICENSE",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
